        "net_decision_read_candidate": {
          "$ref": "#/$defs/net_decision_read_candidate"
        },
        "why_not_stronger": {
          "$ref": "#/$defs/string_list"
        },
        "what_would_change_this_read": {
          "$ref": "#/$defs/string_list"
        },
