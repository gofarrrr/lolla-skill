    "specialist_relation_read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specialist_refs",
        "summary",
        "source_refs",
        "uncertainty_notes"
      ],
      "properties": {
        "specialist_refs": {
          "type": "array",
          "items": {
            "enum": [
              "conversation_interpretation",
              "vanilla_likely_next_action",
              "lolla_likely_next_action",
              "structural_delta",
              "friction_and_lost_value",
              "interpretation_adequacy",
              "advisory_overclaim"
            ]
          },
          "uniqueItems": true
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
