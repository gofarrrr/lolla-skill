    "input_custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "artifacts_read",
        "artifacts_not_read",
        "raw_private_content_copied_to_checked_in_output",
        "archive_mutated",
        "runtime_invoked",
        "notes"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/input_mode"
        },
        "artifacts_read": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "artifacts_not_read": {
          "type": "array",
          "items": {
