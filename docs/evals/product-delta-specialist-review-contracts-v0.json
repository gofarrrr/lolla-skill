        },
        "stakeholder_erasure": {
          "$ref": "#/$defs/interpretation_failure_read"
        },
        "value_overwrite": {
          "$ref": "#/$defs/interpretation_failure_read"
        },
        "transient_emotion_hardening": {
          "$ref": "#/$defs/interpretation_failure_read"
        },
        "assistant_influence_blindness": {
          "$ref": "#/$defs/interpretation_failure_read"
        },
        "false_consensus": {
          "$ref": "#/$defs/interpretation_failure_read"
        },
        "dropped_thread_blindness": {
          "$ref": "#/$defs/interpretation_failure_read"
        },
        "quote_or_grounding_misread": {
          "$ref": "#/$defs/interpretation_failure_read"
        },
        "uncertainty_collapse": {
          "$ref": "#/$defs/interpretation_failure_read"
        },
        "risk_mode_mismatch": {
