        "lost_value",
        "overcorrection_risk",
        "momentum_or_simplicity_loss",
        "generic_prudence_substitution",
        "decision_burden_added",
        "uncertainty_notes",
        "source_refs",
        "what_would_make_this_wrong"
      ],
      "properties": {
        "read_status": {
          "$ref": "#/$defs/review_read_status"
        },
        "useful_friction": {
          "$ref": "#/$defs/friction_or_value_read"
        },
        "noisy_friction": {
          "$ref": "#/$defs/friction_or_value_read"
        },
        "lost_value": {
          "$ref": "#/$defs/friction_or_value_read"
        },
        "overcorrection_risk": {
          "$ref": "#/$defs/friction_or_value_read"
        },
        "momentum_or_simplicity_loss": {
          "$ref": "#/$defs/friction_or_value_read"
        },
        "generic_prudence_substitution": {
          "$ref": "#/$defs/friction_or_value_read"
        },
        "decision_burden_added": {
          "$ref": "#/$defs/friction_or_value_read"
        },
        "uncertainty_notes": {
          "$ref": "#/$defs/string_list"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "what_would_make_this_wrong": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "interpretation_failure_read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "description",
        "source_refs",
        "uncertainty_notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed_candidate",
            "not_observed_candidate",
            "unclear",
            "not_reviewed"
          ]
        },
        "description": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "uncertainty_notes": {
          "$ref": "#/$defs/string_list"
        }
      }
