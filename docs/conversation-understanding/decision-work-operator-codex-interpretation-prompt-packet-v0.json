    "prompt_packet_does_not_call_models_from_repo_code",
    "prompt_packet_does_not_create_generated_read",
    "prompt_packet_is_not_product_proof",
    "prompt_packet_is_not_human_validation",
    "prompt_packet_does_not_score_answer_quality",
    "prompt_packet_does_not_validate_advice_correctness",
