      "enriched_brief_ref": "docs/conversation-understanding/decision-work-brief-builder-enriched-deploy-assisted-intake-routing-v0.md",
      "example_status": "checked_in_safe_reference_only"
    },
    {
      "case_id": "ceo-remove-founding-cofounder",
      "interpretation_read_ref": "reviews/codex-assisted/decision-work-conversation-interpretation-third-tiny-offline-read-v0/read.json",
      "rendered_brief_ref": "docs/conversation-understanding/decision-work-brief-rendered-ceo-remove-founding-cofounder-v0.md",
      "enriched_brief_ref": "docs/conversation-understanding/decision-work-brief-builder-enriched-ceo-remove-founding-cofounder-v0.md",
      "example_status": "checked_in_safe_reference_only_high_risk_caveats_required"
    }
  ],
  "required_output": {
    "schema_version": "lolla.decision_work_conversation_interpretation_read.v0",
    "output_created_by_this_pr": false,
    "must_be_validated_by_future_intake": true,
    "must_preserve_source_refs": true,
    "must_preserve_uncertainty": true,
    "must_preserve_non_claims": true
  },
  "validation_checklist": [
    "source_queue_item_schema_valid",
    "source_queue_item_status_queued",
    "allowed_source_refs_preserved",
    "requested_fields_present",
    "uncertainty_present",
    "missingness_marked",
    "privacy_rules_preserved",
