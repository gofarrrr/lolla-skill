  "triage_categories": [
    {
      "category": "normal_brief_candidate",
      "purpose": "Candidate for user-facing brief only with visible caveats and source limits.",
      "must_not_be_used_as_quality_label": true
    },
    {
      "category": "agent_inspection_only",
      "purpose": "Useful for downstream inspection but not ready for a user-facing brief.",
      "must_not_be_used_as_quality_label": true
    },
    {
      "category": "source_depth_insufficient",
      "purpose": "Checked-in-safe or available source depth is too thin for the requested surface.",
      "must_not_be_used_as_quality_label": true
    },
    {
      "category": "private_context_required",
      "purpose": "Private or local context is required before surfacing or relying on the read.",
      "must_not_be_used_as_quality_label": true
    },
    {
      "category": "high_overtrust_risk",
      "purpose": "The surface may create false confidence or smooth over source limits.",
      "must_not_be_used_as_quality_label": true
    },
    {
      "category": "human_calibration_recommended",
      "purpose": "Human review should calibrate whether the automatic routing is useful or overtrust-inducing.",
      "must_not_be_used_as_quality_label": true
    },
    {
      "category": "domain_review_recommended",
      "purpose": "Domain expertise is recommended before user-surface or runtime planning.",
      "must_not_be_used_as_quality_label": true
    },
    {
      "category": "legal_or_compliance_review_recommended",
      "purpose": "Legal, compliance, or policy review is recommended before any user-surface or operational use.",
      "must_not_be_used_as_quality_label": true
    },
    {
      "category": "relationship_or_political_risk",
      "purpose": "Relationship, governance, employment, board, customer-trust, or internal-political nuance may change the safe surface.",
      "must_not_be_used_as_quality_label": true
    },
    {
      "category": "lost_value_risk",
      "purpose": "The final answer or brief may have lost important option value, tradeoff value, or downside nuance.",
      "must_not_be_used_as_quality_label": true
    },
    {
      "category": "missing_decision_context",
      "purpose": "The decision question, constraints, or action context are too incomplete.",
      "must_not_be_used_as_quality_label": true
    },
    {
      "category": "interpretation_conflict",
      "purpose": "Interpretation reads, local-private checks, or brief evidence disagree enough to require escalation.",
      "must_not_be_used_as_quality_label": true
    },
    {
      "category": "too_thin_to_summarize",
      "purpose": "The system should not produce a smooth summary from the available evidence.",
      "must_not_be_used_as_quality_label": true
    },
    {
      "category": "not_ready_for_user_surface",
      "purpose": "The brief should not be exposed as a user-facing surface.",
      "must_not_be_used_as_quality_label": true
    },
    {
      "category": "runtime_attachment_blocked",
      "purpose": "The artifact is not ready for runtime attachment or automatic downstream use.",
      "must_not_be_used_as_quality_label": true
    }
  ],
