    {
      "mode": "manual_ref_supply_only",
      "allowed": true,
      "default": false,
      "description": "Use only explicit safe refs supplied by an operator.",
      "can_feed_runtime_bundle": true
    },
    {
      "mode": "checked_in_safe_case_registry",
      "allowed": true,
      "default": false,
      "description": "Use a deterministic registry for known checked-in-safe examples and regression fixtures.",
      "can_feed_runtime_bundle": true
    },
    {
      "mode": "archive_local_safe_resolver",
      "allowed": true,
      "default": false,
      "description": "Resolve safe structured artifact status and metadata from a completed archive, while deferring missing semantic brief or triage inputs.",
