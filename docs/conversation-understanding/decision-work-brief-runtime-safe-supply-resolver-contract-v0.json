    {
      "input_name": "checked_in_safe_case_registry_refs",
      "required": false,
      "description": "Optional registry refs for known checked-in-safe demo or regression cases.",
      "safe_handling": "Use only for known cases; never imply general runtime readiness."
    },
    {
      "input_name": "offline_interpretation_queue_refs",
      "required": false,
      "description": "Optional refs to a future offline queue or attachment-needed packet.",
      "safe_handling": "Queue status may explain deferral; it must not create interpretation inside runtime."
