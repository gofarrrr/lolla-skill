  "purpose": {
    "summary": "Define how a future deterministic resolver may decide whether safe run-specific Decision Work Brief inputs exist, where they are, whether they can feed the runtime bundle, or why the attachment must defer, block, or queue.",
    "resolver_is_not": [
      "conversation_interpreter",
      "runtime_model_call_layer",
      "answer_quality_judge",
      "approval_gate",
      "action_authorizer",
      "product_proof"
    ],
    "core_rule": "The resolver supplies refs, status, missingness, privacy policy, and feedability. It does not infer messy conversation meaning."
  },
  "resolver_receives": [
    {
      "input_name": "completed_run_dir_ref",
      "required": true,
      "description": "Relative or operator-supplied ref to the completed run directory after archive completion.",
      "safe_handling": "Use for structured artifact presence, parseability, source refs, and blocker state only."
    },
    {
      "input_name": "runtime_attachment_contract_ref",
      "required": true,
      "description": "Contract governing post-archive attachment modes, states, receipts, blockers, custody flags, and non-claims.",
