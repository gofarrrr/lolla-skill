{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lolla.reasoning_pattern_packet.v0",
  "title": "Lolla Reasoning Pattern Packet v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_metadata", "provenance", "pattern_hypotheses", "routing_projection", "fact_boundary", "lint", "non_claims"],
  "properties": {
    "schema_version": {"const": "lolla.reasoning_pattern_packet.v0"},
    "packet_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "interpretation_schema_version", "graph_runtime_modified"],
      "properties": {
        "packet_id": {"type": "string", "pattern": "^reasoning_pattern_packet:[A-Za-z0-9_-]+$"},
        "interpretation_schema_version": {"type": "string", "minLength": 1},
        "graph_runtime_modified": {"const": false}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_interpretation_ref", "source_interpretation_sha256", "pattern_sources", "raw_text_included"],
      "properties": {
        "source_interpretation_ref": {"type": "string", "minLength": 1},
        "source_interpretation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "raw_text_included": {"const": false},
        "pattern_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pattern_id", "source_semantic_item_ids"],
            "properties": {
              "pattern_id": {"type": "string", "pattern": "^rp_[0-9]{3}$"},
              "source_semantic_item_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"}
              }
            }
          }
        }
      }
    },
    "pattern_hypotheses": {
      "type": "array",
      "items": {"$ref": "#/$defs/pattern_hypothesis"}
    },
    "routing_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "pattern_nodes", "pattern_edges", "contains_case_context"],
      "properties": {
        "schema_version": {"const": "lolla.graph_reasoning_pattern_projection.v0"},
        "contains_case_context": {"const": false},
        "pattern_nodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/routing_node"}
        },
        "pattern_edges": {
          "type": "array",
          "items": {"$ref": "#/$defs/routing_edge"}
        }
      }
    },
    "fact_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_text_included", "quotes_included", "entities_included", "case_quantities_included", "dates_included", "desired_outcome_included", "topic_labels_included"],
      "properties": {
        "raw_text_included": {"const": false},
        "quotes_included": {"const": false},
        "entities_included": {"const": false},
        "case_quantities_included": {"const": false},
        "dates_included": {"const": false},
        "desired_outcome_included": {"const": false},
        "topic_labels_included": {"const": false}
      }
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "violations"],
      "properties": {
        "status": {"enum": ["pending", "passed", "failed"]},
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "json_pointer"],
            "properties": {
              "code": {"type": "string", "minLength": 1},
              "json_pointer": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "pattern_hypotheses_are_provisional",
          "not_human_validation",
          "not_reasoning_quality_proof",
          "not_advice_correctness_proof",
          "not_end_to_end_determinism",
          "missing_in_capture_is_not_missing_in_reality"
        ]
      }
    }
  },
  "$defs": {
    "mechanism_id": {
      "enum": [
        "status_signal_used_as_evidence",
        "ambiguous_signal_treated_as_commitment",
        "acknowledged_constraint_not_gated",
        "criteria_defined_after_commitment",
        "initial_frame_persists_after_question_change",
        "counterpressure_acknowledged_not_integrated",
        "reversible_path_not_considered",
        "upside_downside_evidence_asymmetry",
        "missing_reversal_condition",
        "other_review_required"
      ]
    },
    "pattern_hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern_id", "mechanism_id", "subject_scope", "state", "support_status", "routing_eligible"],
      "properties": {
        "pattern_id": {"type": "string", "pattern": "^rp_[0-9]{3}$"},
        "mechanism_id": {"$ref": "#/$defs/mechanism_id"},
        "subject_scope": {"enum": ["user", "assistant", "joint_process"]},
        "state": {"enum": ["present", "missing_protection", "tension"]},
        "support_status": {"enum": ["provisional_source_linked", "human_reviewed"]},
        "routing_eligible": {"type": "boolean"}
      }
    },
    "routing_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern_id", "mechanism_id", "subject_scope", "state"],
      "properties": {
        "pattern_id": {"type": "string", "pattern": "^rp_[0-9]{3}$"},
        "mechanism_id": {"$ref": "#/$defs/mechanism_id"},
        "subject_scope": {"enum": ["user", "assistant", "joint_process"]},
        "state": {"enum": ["present", "missing_protection", "tension"]}
      }
    },
    "routing_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_pattern_id", "to_pattern_id", "relation"],
      "properties": {
        "from_pattern_id": {"type": "string", "pattern": "^rp_[0-9]{3}$"},
        "to_pattern_id": {"type": "string", "pattern": "^rp_[0-9]{3}$"},
        "relation": {"enum": ["precedes", "persists_after", "reinforces", "counterpressure_to", "missing_protection_for"]}
      }
    }
  }
}
