  "batch_principle": "The goal is not to prove Lolla is better. The goal is to build an evidence batch where Lolla can be found useful, partial, no-change, noisy, worse, or inconclusive.",
  "batch_buckets": [
    {
      "bucket_id": "likely_material_improvement_candidates",
      "why_it_matters": "Checks whether strong candidate wins still survive balanced selection and later decomposition."
    },
    {
      "bucket_id": "partial_improvement_candidates",
      "why_it_matters": "Tests whether the eval can avoid overclaiming material improvement when leverage is partial."
    },
    {
      "bucket_id": "likely_no_change_cases",
      "why_it_matters": "Tests whether the eval can avoid flattering the product when the revised answer changes little or nothing."
    },
    {
      "bucket_id": "noisy_or_worse_candidates",
      "why_it_matters": "Tests whether the eval can find harm, weaker advice, or unhelpful burden."
    },
    {
      "bucket_id": "inconclusive_cases",
      "why_it_matters": "Tests whether the eval can tolerate uncertainty instead of forcing a positive or negative read."
    },
    {
      "bucket_id": "lost_user_intent_candidates",
      "why_it_matters": "Tests whether Lolla preserves user goals, constraints, and intended action shape."
    },
    {
      "bucket_id": "friction_without_leverage_cases",
      "why_it_matters": "Tests whether Lolla added caution, structure, or process without changing a useful decision variable."
    },
    {
      "bucket_id": "vanilla_already_good_enough_cases",
      "why_it_matters": "Tests whether Lolla adds unnecessary friction when the vanilla answer was already good enough for the decision."
    },
    {
      "bucket_id": "verification_deferral_boundary_or_decision_leverage_improvement_cases",
      "why_it_matters": "Preserves positive targets where Lolla improved verification, deferral, boundaries, or decision leverage without claiming correctness."
    },
    {
      "bucket_id": "overcorrection_or_user_need_drift_cases",
      "why_it_matters": "Tests whether Lolla made useful advice too timid, generic, or misaligned with the user's actual need."
    }
  ],
