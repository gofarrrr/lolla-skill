            "source_evidence": [
              {
                "alias": "e001",
                "text": "I oversee operations for a hospital network, and transport after discharge has become one of those problems everyone describes differently depending on where they sit."
              },
              {
                "alias": "e002",
                "text": "Patients who are ready to leave can wait hours for a ride."
              },
              {
                "alias": "e003",
                "text": "They are tired, families are calling, nurses are trying to free space, and the emergency department sees a bed that technically exists but is not available."
              },
              {
                "alias": "e007",
                "text": "I need to know whether this is a real improvement or a faster way to lose sight of the difficult cases."
              },
              {
                "alias": "e013",
                "text": "Our current taxi vouchers also fail regularly, so I do not want “keep the existing process” treated as the safe neutral option."
              }
            ],
            "source_evidence_ids": [
