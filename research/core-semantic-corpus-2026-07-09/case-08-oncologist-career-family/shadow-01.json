            "start_char": 972,
            "turn_index": 3
          }
        },
        "resolved_at_turn": null,
        "status": "active",
        "superseded_by": null,
        "text": "my mother has early-onset dementia, lives in Chicago, and I fly there once a month."
      },
      {
        "introduced_at_turn": 4,
        "issue_id": "live_constraint_t4_constraint_50eb25c951ed",
        "kind": "constraint",
        "kind_ambiguity": false,
        "provenance": {
          "kind": "span",
          "span_ref": {
            "end_char": 519,
            "speaker": "user",
            "start_char": 324,
            "turn_index": 4
          }
        },
        "resolved_at_turn": null,
        "status": "active",
        "superseded_by": null,
        "text": "I have a patient, Robert, stage IV lung cancer. He specifically asked for me, he came to BAMC because of my work on a particular trial combination. I'm designing his treatment protocol right now."
      },
      {
        "introduced_at_turn": 8,
        "issue_id": "live_constraint_t8_constraint_871a689ad421",
        "kind": "constraint",
        "kind_ambiguity": false,
        "provenance": {
          "kind": "span",
          "span_ref": {
            "end_char": 163,
            "speaker": "user",
            "start_char": 88,
            "turn_index": 8
          }
        },
        "resolved_at_turn": null,
        "status": "active",
        "superseded_by": null,
        "text": "Merck's contract includes a 2-year non-compete on immunotherapy development"
      },
      {
        "introduced_at_turn": 4,
        "issue_id": "live_constraint_t4_constraint_8a796c876d5b",
        "kind": "constraint",
