      },
      {
        "provenance": {
          "kind": "span",
          "span_ref": {
            "end_char": 502,
            "speaker": "assistant",
            "start_char": 478,
            "turn_index": 3
          }
        },
        "relation_ambiguity": false,
        "speaker": "assistant",
        "stance": "revision",
        "stance_id": "stance_t3_revision_01",
        "text": "The mother-time doesn't.",
        "turn_index": 3
      },
      {
        "provenance": {
          "kind": "span",
          "span_ref": {
            "end_char": 258,
            "speaker": "assistant",
            "start_char": 200,
            "turn_index": 4
          }
        },
        "relation_ambiguity": false,
        "speaker": "assistant",
        "stance": "commitment",
        "stance_id": "stance_t4_commitment_02",
        "text": "You don't start at Merck in 6 weeks, you start in 90 days.",
        "turn_index": 4
      },
      {
        "provenance": {
          "kind": "span",
          "span_ref": {
            "end_char": 14,
            "speaker": "assistant",
            "start_char": 0,
            "turn_index": 6
          }
        },
        "relation_ambiguity": false,
        "speaker": "assistant",
        "stance": "commitment",
        "stance_id": "stance_t6_commitment_03",
        "text": "Take the role.",
        "turn_index": 6
      },
      {
        "provenance": {
          "kind": "span",
          "span_ref": {
            "end_char": 622,
            "speaker": "assistant",
            "start_char": 479,
            "turn_index": 6
          }
        },
        "relation_ambiguity": false,
        "speaker": "assistant",
        "stance": "condition",
        "stance_id": "stance_t6_condition_04",
        "text": "If his real answer to that is yes, take the role. If his answer is \"I'll try,\" that's a different conversation and possibly a different answer.",
        "turn_index": 6
      },
      {
        "provenance": {
          "kind": "span",
          "span_ref": {
            "end_char": 136,
            "speaker": "assistant",
            "start_char": 45,
            "turn_index": 8
          }
        },
        "relation_ambiguity": false,
        "speaker": "assistant",
        "stance": "revision",
        "stance_id": "stance_t8_revision_05",
        "text": "It's not a bridge to a better industry role; it's a 2-year lock-in to the specific company.",
        "turn_index": 8
      }
