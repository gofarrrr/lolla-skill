        "resolved_at_turn": null,
        "status": "active",
        "superseded_by": null,
        "text": "I have 10 days to decide."
      },
      {
        "introduced_at_turn": 1,
        "issue_id": "live_constraint_t1_constraint_21efed03e9b4",
        "kind": "constraint",
