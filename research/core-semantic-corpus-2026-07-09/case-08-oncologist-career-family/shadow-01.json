            "turn_index": 1
          }
        },
        "resolved_at_turn": null,
        "status": "active",
        "superseded_by": null,
        "text": "My husband can't really move — he's partner at a Boston firm, there's non-compete stuff plus his whole book of business is here."
      },
      {
        "introduced_at_turn": 3,
        "issue_id": "live_constraint_t3_constraint_b462a689fe43",
