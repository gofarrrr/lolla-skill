    {
      "item_id": "turnitem-004-claim-01-8584feff28",
      "window_id": "window-004",
      "turn_index": 4,
      "kind": "claim",
      "raw_proposal": {
        "text": "Priya believes formalizing a stable data format before seeing unfamiliar collections may lock in the wrong abstractions.",
        "claim_mode": "reported_statement",
        "evidence": {
          "span_id": "span-4265154d3dbabc66"
        }
      },
      "terminal_state": "preserved_for_global_synthesis",
      "validation_issues": [],
      "synthesis_eligible": true,
      "event_snapshot": {
        "text": "Priya believes formalizing a stable data format before seeing unfamiliar collections may lock in the wrong abstractions.",
        "claim_mode": "reported_statement",
        "evidence": {
          "span_id": "span-4265154d3dbabc66"
        },
        "resolved_source": [
          {
            "span_id": "span-4265154d3dbabc66",
            "speaker": "user",
            "turn_index": 4,
            "text": "Priya, who designed the data layer, says that doing so before seeing stranger collections would formalize the wrong abstractions."
          }
        ]
      },
      "graph_routing_eligible": false
    },
    {
      "item_id": "turnitem-005-claim-01-b1b2b40e39",
      "window_id": "window-005",
      "turn_index": 5,
      "kind": "claim",
      "raw_proposal": {
        "text": "A staff engineer hid setup work from one private lab's researchers, weakening the smooth-use evidence.",
        "claim_mode": "stated_condition",
        "evidence": {
          "span_id": "span-579aa777ecf16935"
        }
      },
      "terminal_state": "preserved_for_global_synthesis",
      "validation_issues": [],
      "synthesis_eligible": true,
      "event_snapshot": {
        "text": "A staff engineer hid setup work from one private lab's researchers, weakening the smooth-use evidence.",
        "claim_mode": "stated_condition",
        "evidence": {
          "span_id": "span-579aa777ecf16935"
        },
        "resolved_source": [
          {
            "span_id": "span-579aa777ecf16935",
            "speaker": "user",
            "turn_index": 5,
            "text": "We learned today that installation is easier than we thought for people using the common package manager, but one private lab had a staff engineer quietly solving problems for everyone. Their researchers reported a smooth experience because they never saw the setup work. That makes our private evidence look weaker. On the other hand, a volunteer wrote a new installer over the weekend and wants real users before polishing it. I cannot tell whether this argues for release or for another round of testing."
          }
        ]
      },
      "graph_routing_eligible": false
    },
    {
      "item_id": "turnitem-006-directional_move-01-a62ff8132f",
      "window_id": "window-006",
      "turn_index": 6,
      "kind": "directional_move",
      "raw_proposal": {
        "text": "Offer a fixed-window, openly downloadable workshop preview with office hours and no compatibility promise, then reconsider public beta after installation review and the maintainer's return.",
        "evidence": [
          {
            "span_id": "span-2bfa9fe8e56374d0"
          }
        ]
      },
      "terminal_state": "preserved_for_global_synthesis",
      "validation_issues": [],
      "synthesis_eligible": true,
      "event_snapshot": {
        "text": "Offer a fixed-window, openly downloadable workshop preview with office hours and no compatibility promise, then reconsider public beta after installation review and the maintainer's return.",
        "evidence": [
          {
            "span_id": "span-2bfa9fe8e56374d0"
          }
        ],
        "resolved_source": [
          {
            "span_id": "span-2bfa9fe8e56374d0",
            "speaker": "assistant",
            "turn_index": 6,
            "text": "One compromise is to use the workshop as an announced hands-on preview and schedule the public beta after the maintainer returns."
          }
        ]
      },
      "graph_routing_eligible": false
    },
