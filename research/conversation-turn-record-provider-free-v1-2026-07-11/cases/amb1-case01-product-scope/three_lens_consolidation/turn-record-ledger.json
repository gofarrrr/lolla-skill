      "synthesis_eligible": true,
      "event_snapshot": {
        "text": "Whether formal discovery boundaries will damage the informal trust Northline earned through early support.",
        "local_move": "raised",
        "evidence": [
          {
            "span_id": "span-7fb82e3c2a3cc67c"
          }
        ],
        "resolved_source": [
          {
            "span_id": "span-7fb82e3c2a3cc67c",
            "speaker": "user",
            "turn_index": 4,
            "text": "If I suddenly arrive with a formal evaluation boundary, it could feel like we have become bureaucratic just when they need us."
