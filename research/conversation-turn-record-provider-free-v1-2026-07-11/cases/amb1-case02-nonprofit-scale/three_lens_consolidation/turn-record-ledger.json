      "event_snapshot": {
        "text": "A foundation officer informally said geographic reach may make the application easier to explain; no funding was promised.",
        "claim_mode": "possibility",
        "evidence": {
          "span_id": "span-808bf191edd9d65e"
        },
        "resolved_source": [
          {
            "span_id": "span-808bf191edd9d65e",
            "speaker": "user",
            "turn_index": 5,
            "text": "There is funding context too. A foundation officer told me informally that geographic reach would make our next application easier to explain. She did not promise anything, and the current grant pays for curriculum improvement, not expansion. If we delay, we can improve the drop-in materials and volunteer training. If we expand, we have a stronger story but might be stretching restricted work into the background. I am embarrassed by how much the application narrative is affecting me."
          }
        ]
      },
      "graph_routing_eligible": false
