      "turn_index": 3,
      "kind": "claim",
      "raw_proposal": {
        "text": "Willow Hub can provide a room and promotion but cannot promise staff coordination.",
        "claim_mode": "reported_statement",
        "evidence": {
          "span_id": "span-b6ff31fe4da5b62e"
        }
      },
      "terminal_state": "preserved_for_global_synthesis",
      "validation_issues": [],
      "synthesis_eligible": true,
      "event_snapshot": {
        "text": "Willow Hub can provide a room and promotion but cannot promise staff coordination.",
        "claim_mode": "reported_statement",
        "evidence": {
          "span_id": "span-b6ff31fe4da5b62e"
        },
        "resolved_source": [
          {
            "span_id": "span-b6ff31fe4da5b62e",
            "speaker": "user",
            "turn_index": 3,
            "text": "Willow Hub can give us a room and promote the sessions. I had been talking as if they would also coordinate locally, but their director clarified that they cannot promise staff time. Our volunteer lead still wants to do it. She says new volunteers are more likely to join something that feels like growth than something described as fixing operations. I partly agree, and I partly think we are using inspiration to avoid the unglamorous work."
          }
        ]
      },
      "graph_routing_eligible": false
    },
