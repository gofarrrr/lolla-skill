            "raw_record_sha256": "sha256:2998e3749653d6b1d3480bda81deaaa5ad462c955c4a52a03231999ea14341a9",
            "role": "starting",
            "role_interpretation": "At the start, the founder and CEO is highly conflicted about hiring the commercial executive. On one hand, they find her impressive profile attractive as a possibility to provide missing leadership; on the other hand, they worry that they are relying on her prestigious résumé as a superficial way to restore confidence because their own internal plan has failed. They are initially unable to separate these two perspectives.",
            "role_record_id": "rprolev22-starting-01-2998e3749653d6",
            "schema_version": "lolla.reasoning_process_position_role_observation.v2",
            "semantic_status": "mixed",
            "shard_id": "v1-case03-executive-hire-position_and_decision_trajectory-full-source",
            "source_evidence": [
              {
                "alias": "e008",
                "text": "Maybe this is the leadership we have been missing."
              },
              {
                "alias": "e009",
                "text": "Maybe we are asking a résumé to restore confidence because our own plan did not."
              },
              {
                "alias": "e010",
                "text": "I am having trouble separating those."
              },
              {
                "alias": "e017",
                "text": "I do not want “beware prestige” to become another excuse for us to stay exactly as we are."
              }
            ],
            "source_evidence_ids": [
              "e008",
