          "semantic_payload": {
            "case_id": "v1-case03-executive-hire",
            "fidelity_note": "This starting position represents the founder's initial struggle to separate the excitement over a prestigious candidate from genuine strategic necessity. Although investors and the board are relieved by her name (e006), the founder is deeply uncertain (e010) and presents competing hypotheses (e008, e009). However, the founder emphasizes that despite warnings about prestige, the company legitimately needs change and should not use caution as an excuse to stay in their current plateau (e014, e017).",
            "graph_routing_eligible": false,
            "limitations": "This starting record focuses strictly on the early turns where the decision is unresolved and the founder is weighing competing instincts. Later concrete developments, such as the evaluation of the 100-day plan, references, and final negotiation, are excluded.",
            "observation_id": "rprolev22-starting-01-2998e3749653d6",
            "provenance": {
              "call_id": "",
              "model": "",
              "producer_id": "google/gemini-3.5-flash-20260519",
