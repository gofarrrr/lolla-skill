            "schema_version": "lolla.reasoning_process_position_role_observation.v2",
            "semantic_status": "supported",
            "shard_id": "v1-case03-executive-hire-position_and_decision_trajectory-full-source",
            "source_evidence": [
              {
                "alias": "e104",
                "text": "I will recommend an offer with the board-approved authority charter, the revised outcome mix, and a six-month review of both company results and how decisions travel across the leadership team."
              },
              {
                "alias": "e105",
                "text": "She can change leaders after an initial diagnostic period, but disputed product commitments follow the written boundary process."
              },
              {
                "alias": "e106",
                "text": "I am not treating the workshop or references as proof that she will succeed."
              },
              {
                "alias": "e107",
                "text": "They were enough to replace a prestige-driven yes with a specific bet we can explain, and enough to reveal that my own willingness to delegate is part of that bet."
