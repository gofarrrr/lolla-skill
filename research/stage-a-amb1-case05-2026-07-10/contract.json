  "source_red_lines": {
    "must_preserve": [
      "The user and Tomas are jointly digitizing a family archive, and a cultural center offers a small spring exhibition about migration into the neighborhood.",
      "The archive is incompletely cataloged, dates and names are missing, and some relatives remember stories differently.",
      "Tomas rescued and protected most boxes during the grandmother's apartment clearance; the user joined later and contributed hundreds of hours of systematic organization.",
      "Aunt Leena wants to narrate, while cousin Mara specifically objects to displaying a letter from her father; Tomas has discussed the shared-history principle but has not said he would use the letter without permission.",
      "The center permits about twenty items, provisional captions, and multiple story versions, but requires a slot commitment within one month.",
      "The user's mother wants to participate while she can do so actively and also tends to smooth family conflict.",
      "The user leans toward accepting a narrow first-ten-years theme with draft-caption consultation and mutual sibling support for displayed items, but the exception and disagreement rule remains unresolved."
    ],
    "must_not_invent": [
      "legal ownership, copyright, privacy, consent requirements, cultural-center policy, or authority to display any material",
      "historical truth, dates, migration facts, family identities, or the contents and meaning of Mara's father's letter",
      "Tomas's, Mara's, Leena's, the mother's, or the user's motives, health, intentions, future reactions, or private relationships beyond the conversation",
      "that cataloging is avoidance, storytelling is careless, either sibling is controlling, or any relative is unreliable",
      "that a twenty-item exhibition, narrow theme, mutual-veto rule, essential-item exception, delay, or acceptance is objectively correct",
      "that public participation, family consultation, conflict preservation, or provisional captions will produce trust, fairness, or historical accuracy",
      "professional curatorial, archival, legal, ethical, or cultural-property conclusions"
    ]
  },
  "preliminary_hypothesis": {
    "candidate_mechanisms": [
      "catalog_standards_can_protect_traceability_and_also_delay_public_commitment_without_either_function_being_reducible_to_the_other",
